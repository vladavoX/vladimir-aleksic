# Cloudflare Workers assets headers. Only static-asset responses come through
# here — the SSR document is rendered by the Worker, and gets the same four
# headers from `SECURITY_HEADERS` in src/security-headers.ts, via the root
# route's `headers()`. src/security-headers.test.ts fails if the two drift.
/*
  Referrer-Policy: strict-origin-when-cross-origin
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
